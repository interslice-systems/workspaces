workspaces="$plugin_dir/Workspaces.qml"
menu="$plugin_dir/WsMenu.qml"
firefox_icon="$plugin_dir/assets/firefox.png"
fails=0

pass() { printf 'ok   - %s\n' "$1"; }
fail() { printf 'FAIL - %s\n' "$1"; fails=$((fails + 1)); }

assert_contains() {
  local name=$1 needle=$2 file=$3
  if rg -Fq "$needle" "$file"; then pass "$name"; else
    fail "$name"
    printf '       missing from %s: %s\n' "$file" "$needle"
  fi
}

assert_not_contains() {
  local name=$1 needle=$2 file=$3
  if rg -Fq "$needle" "$file"; then
    fail "$name"
    printf '       forbidden in %s: %s\n' "$file" "$needle"
  else pass "$name"; fi
}

assert_not_matches() {
  local name=$1 pattern=$2 file=$3
  if rg -Uq -- "$pattern" "$file"; then
    fail "$name"
    printf '       forbidden pattern in %s: %s\n' "$file" "$pattern"
  else pass "$name"; fi
}

assert_multiline() {
  local name=$1 needle=$2 file=$3
  if rg -U -Fq -- "$needle" "$file"; then pass "$name"; else
    fail "$name"
    printf '       missing multiline contract from %s:\n%s\n' "$file" "$needle"
  fi
}

assert_count() {
  local name=$1 expected=$2 needle=$3 file=$4 actual
  actual=$(rg -F -o -- "$needle" "$file" 2>/dev/null | wc -l)
  if (( actual == expected )); then pass "$name"; else
    fail "$name"
    printf '       expected %s occurrence(s), found %s: %s\n' "$expected" "$actual" "$needle"
  fi
}

assert_regex_count() {
  local name=$1 expected=$2 pattern=$3 file=$4 actual
  actual=$(rg -U --count-matches -- "$pattern" "$file" 2>/dev/null)
  actual=${actual:-0}
  if (( actual == expected )); then pass "$name"; else
    fail "$name"
    printf '       expected %s regex match(es), found %s: %s\n' "$expected" "$actual" "$pattern"
  fi
}

